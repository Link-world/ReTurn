# Copy to .env, fill locally, then: set -a; . ./.env; set +a
# Bases include /v1 (or your provider's compatible-mode/v1), NOT /chat/completions.
# Use an account/endpoint serving the exact configured model ID. Never commit secrets.
OMNI_BASE_URL=
OMNI_API_KEY=
VISUAL_BASE_URL=
VISUAL_API_KEY=
AUDIO_BASE_URL=https://api.stepfun.com/v1
AUDIO_API_KEY=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=gpt-5.6-sol
# Optional local model directories; unset means use the public model repository ID.
# LOCAL_OMNI_MODEL=/your/models/Qwen3-Omni-30B-A3B-Instruct
# LOCAL_VISUAL_MODEL=/your/models/Qwen3-VL-30B-A3B-Instruct
# LOCAL_AUDIO_MODEL=/your/models/Audio-Flamingo-3-hf
